# Copy to .env.local for local development.
# On Render, set these in the Web Service → Environment tab.

# --- Required ---
MONGODB_URI=mongodb://127.0.0.1:27017/ethioplate
JWT_SECRET=replace-with-long-random-secret
# Comma-separated browser origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081

# Local only (Render sets PORT automatically)
API_PORT=4000
NODE_ENV=development

# --- Production example (Render) ---
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.../ethioplate
# JWT_SECRET=<strong-random-secret>
# CORS_ORIGIN=https://spxbarista-fr.vercel.app

# Print agent (optional — cashier laptop only)
# PRINT_GATEWAY_EMAIL=
# PRINT_GATEWAY_PASSWORD=
# PRINT_GATEWAY_CODE=
# PRINT_ADAPTER=windows
# WINDOWS_PRINTER_NAME=
